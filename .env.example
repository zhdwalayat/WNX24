# OpenAI (optional — currently unused by the pipeline, reserved for future use)
OPENAI_API_KEY=sk-...

# Groq (required — powers script writing, llama-3.3-70b-versatile)
# Get a free key at https://console.groq.com
GROQ_API_KEY=gsk_...

# HeyGen (optional — paid avatar video, currently disabled in agents/avatar_agent.py)
HEYGEN_API_KEY=...
HEYGEN_AVATAR_ID=...
HEYGEN_VOICE_ID=...

# NewsAPI (optional — powers agents/news_api_agent.py)
# Get a free key at https://newsapi.org
NEWSAPI_KEY=...

# Reddit (optional — not currently used; Reddit is scraped via public RSS, no OAuth needed)
REDDIT_CLIENT_ID=...
REDDIT_CLIENT_SECRET=...

# YouTube Data API v3 (required for real uploads — falls back to mock uploads if missing)
YOUTUBE_API_KEY=...
YOUTUBE_CHANNEL_ID=...

# Optional — raise once your channel's real upload limit is confirmed (default 10/24h)
YOUTUBE_MAX_DAILY_UPLOADS=10

# Optional — edge-tts narration voice (default en-US-AriaNeural)
EDGE_TTS_VOICE=en-US-AriaNeural

# Unsplash (optional — free tier image source for agents/image_agent.py)
# Register free at: unsplash.com/developers
UNSPLASH_ACCESS_KEY=your-key-here

# Pexels (optional — free tier image source for agents/image_agent.py)
# Register free at: pexels.com/api
PEXELS_API_KEY=your-key-here
